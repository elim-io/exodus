    {
      "i": 1,
      "title": "Dockerfile and a health check route",
      "detail": "Dockerfile exists: check that it listens on $PORT; GET /healthz answers 200 once cards_data answers.",
      "effort": "S",
      "phase": 1,
      "status": "todo"
    },
    {
      "i": 2,
      "title": "SQLite to Firestore",
      "detail": "Replace the database/sql calls with cloud.google.com/go/firestore: a collection per table, a document per row, a transaction where the code needs one, and a composite index for each query that filters or sorts on two fields. The tests run against the Firestore emulator.",
      "effort": "L",
      "phase": 2,
      "fixes": "sqlite-database",
      "status": "todo"
    },
    {
      "i": 3,
      "title": "Timers to Cloud Scheduler",
      "detail": "Give each schedule an endpoint (POST /cron/<name>, OIDC token checked) or a Cloud Run job, create a Cloud Scheduler job per schedule with its time zone, then remove the timer and its process.",
      "effort": "M",
      "phase": 2,
      "fixes": "in-process-timer",
      "status": "todo"
    },
    {
      "i": 4,
      "title": "Infrastructure: service, Firestore, scheduler",
      "detail": "Max 3 instances to begin with; the busiest hour decides when to raise it. Firestore's (default) database in Native mode in the service's region, the one database the free quota covers; the service's account gets roles/datastore.user.",
      "effort": "M",
      "phase": 3,
      "status": "todo"
    },
    {
      "i": 5,
      "title": "Keyless deploys from CI",
      "detail": "The deploy signs in with Workload Identity Federation; no key file anywhere.",
      "effort": "S",
      "phase": 3,
      "status": "todo"
    },
    {
      "i": 6,
      "title": "Data: copy cards_data and compare",
      "detail": "a one-off script copies each SQLite table into a Firestore collection, a row a document, then the documents of each collection are counted against the table's rows.",
      "effort": "M",
      "phase": 4,
      "status": "todo"
    },
    {
      "i": 7,
      "title": "Switch the domain and stop Fly.io",
      "detail": "Point the domains at Cloud Run in a quiet hour; Fly.io stays stopped, not deleted, for a week.",
      "effort": "S",
      "phase": 4,
      "status": "todo"
    }
