      "i": 6,
      "title": "Infrastructure: service, Cloud SQL, bucket, queue, scheduler",
      "detail": "Max 3 instances and a database pool of 5 a copy, because db-f1-micro takes 25 connections.",
      "effort": "M",
      "phase": 3,
      "status": "todo"
