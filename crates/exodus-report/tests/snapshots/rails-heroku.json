  "verdict": {
    "kind": "move-after",
    "label": "Ready after 2 changes",
    "title": "You can move rails-heroku to Cloud Run after 2 changes",
    "reason": "The files on disk and the worker need a change each before Cloud Run; the rest moves as it is."
  },
  "findings": [
    {
      "i": 1,
      "id": "local-disk-write",
      "kind": "breaks",
      "title": "Files written to local disk",
      "at": "config/environments/production.rb:3",
      "code": "config.active_storage.service = :local",
      "why": "An instance's disk lives in its memory: a file counts against the memory limit, is gone when the instance stops, and other instances never see it, so an upload saved on one is a 404 on the next.",
      "fix": "Active Storage on a Cloud Storage bucket (the GCS service in storage.yml), with signed URLs; other writes go to the bucket too.",
      "part": "storage",
      "kb": "files-and-uploads-with-cloud-storage",
      "subject": "the files on disk",
      "task": 2
    },
    {
      "i": 2,
      "id": "queue-worker",
      "kind": "breaks",
      "title": "A worker waits on a Redis queue",
      "at": "config/environments/production.rb:4",
      "code": "config.active_job.queue_adapter = :sidekiq",
      "why": "Cloud Run gives an instance CPU only while it answers a request, so a worker waiting on a queue gets no CPU between requests and its jobs stall. With CPU always allocated it runs, and bills every second whether there is work or not.",
      "fix": "Cloud Tasks: each job becomes a POST to /tasks/<name> on the service, through an Active Job adapter for Cloud Tasks or a task created where perform_later was called. Retries move to the queue.",
      "part": "worker",
      "kb": "background-workers-with-cloud-tasks",
      "subject": "the worker",
      "task": 3
    },
    {
      "i": 3,
      "id": "release-migrations",
      "kind": "note",
      "title": "Migrations run in a release step",
      "at": "Procfile:3",
      "code": "release: bin/rails db:migrate",
      "why": "Cloud Run has no release phase, and a migration in the container's start command runs once per instance, several at the same time.",
      "fix": "A Cloud Run job runs the migrations with the new image, and the deploy waits for it before it sends traffic to the new revision.",
      "part": "release",
      "kb": "database-migrations-as-cloud-run-jobs",
      "task": 4
    },
    {
      "i": 4,
      "id": "heroku-scheduler",
      "kind": "note",
      "title": "Heroku Scheduler runs jobs the repository does not list",
      "at": "app.json:7",
      "code": "\"scheduler:standard\"",
      "why": "Heroku Scheduler is an add-on that stays behind, and its jobs and their times live only in the Heroku dashboard.",
      "fix": "Copy each job from the dashboard (heroku addons:open scheduler) into Cloud Scheduler, which starts it as a Cloud Run job.",
      "part": "scheduler",
      "kb": "cron-and-timers-with-cloud-scheduler",
      "task": 5
    }
